        "stream": false
      },
      "assertions": [
        "HTTP 401",
        "错误 body 可解析",
        "错误语义明确为认证失败",
        "不返回 HTTP 200 伪成功"
      ],
      "expected": {
        "http_status": 401,
        "error": {
          "message_contains": [
            "auth",
            "key",
            "unauthorized"
          ]
        }
      }
    },
    {
      "id": "K3-AUTH-002",
      "category": "认证与错误",
      "priority": "P0",
      "name": "限流错误",
      "request": {
        "stream": false,
        "scenario": "在并发/额度受限条件下触发限流"
      },
      "assertions": [
        "HTTP 429",
        "错误 body 可解析",
        "语义明确为限流/速率超限",
        "不把 429 改写为 400 或 500",
        "如原厂提供 Retry-After，则字段语义一致"
      ],
      "expected": {
        "http_status": 429,
        "error": {
          "message_contains": [
            "rate",
            "limit",
            "quota",
            "too many"
          ]
        }
      }
    },
