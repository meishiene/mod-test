{
  "suite_id": "KIMI-K3-TEMP-20260909",
  "title": "Kimi-K3 供应商临时自测案例集",
  "version": "0.2-temp",
  "changelog": [
    "0.2-temp（2026-10-14）：按 K3 官方契约修订——temperature/top_p 正向改用固定值（1 / 0.95）、非固定值改为负向拒绝；thinking 显式形态补 keep=all、关闭项改观察项；需要可见正文的用例输出预算抬到 ≥512；缓存判定改为「命中 probe 占比 ≥80%」；CACHE-HIT-10 更名为 CACHE-HIT-7（实际 7 次探测）。"
  ],
  "source_document": "Kimi-K3 供应商自测基线标准 0828",
  "contract_baseline": "Kimi-K3 官方契约（2026-10-14 复核）",
  "scope": "接口兼容性（18条）、性能（40条）、缓存（10条）和自测准入，共68条原子案例；不包含 arxivmath、DeepSWE、SWE-Atlas TW/RF、Legal Agent Benchmark 等开源评测集",
  "official_contract": {
    "reviewed_at": "2026-10-14",
    "note": "本清单的取值必须落在 K3 官方契约内；下列参数为固定值，用例只能用固定值做正向、用非固定值做负向，不得把非固定值当合法默认值。",
    "fixed_params": {
      "temperature": 1.0,
      "top_p": 0.95,
      "n": 1,
      "presence_penalty": 0,
      "frequency_penalty": 0
    },
    "thinking": {
      "closable": false,
      "explicit_form": {
        "type": "enabled",
        "keep": "all"
      },
      "note": "K3 思考关不掉；显式传 thinking 只接受 {\"type\":\"enabled\",\"keep\":\"all\"}，该参数本身是 K2.x 形态"
    },
    "output_limit": {
      "field": "max_completion_tokens",
      "default": 131072,
      "maximum": 1048576
    },
    "thinking_token_budget_note": "思考常开且思考 token 计入输出上限：需要可见正文的用例必须给足输出预算（≥512），小预算下「零可见正文」是原厂行为，不是模型缺陷。",
    "sources": [
      "https://platform.moonshot.ai/docs/api/models-overview",
      "https://platform.moonshot.cn/docs/guide/kimi-k3-quickstart",
      "https://platform.kimi.com/docs/guide/response_format"
    ]
  },
  "common": {
    "endpoint": "POST /chat/completions",
    "protocol": "OpenAI Chat Completions，stream=true 时使用 SSE",
    "required_request_fields": [
      "model",
      "messages"
    ],
    "required_usage_fields": [
      "prompt_tokens",
      "completion_tokens",
      "cached_tokens"
    ],
    "default_stream": true,
    "default_max_tokens": 512,
    "default_concurrency": 10,
    "evidence": [
      "请求体",
      "HTTP 状态码",
      "完整响应/SSE 原文",
      "usage",
      "request_id",
      "耗时",
      "断言结果"
    ]
  },
  "cases": [
    {
      "id": "K3-CONN-001",
      "category": "基础连通",
      "priority": "P0",
      "name": "非流式基础调用",
      "request": {
        "stream": false,
        "messages": [
          {
            "role": "user",
            "content": "只回复 OK"
          }
        ],
        "max_tokens": 512
      },
      "assertions": [
        "HTTP 200",
        "返回 choices[0].message.content",
        "usage 含 prompt_tokens、completion_tokens、cached_tokens（cached_tokens 可位于 usage.prompt_tokens_details）",
        "响应可解析为 JSON",
        "响应或响应头存在可追溯 request_id"
      ],
      "expected": {}
    },
    {
      "id": "K3-CONN-002",
      "category": "基础连通",
      "priority": "P0",
      "name": "流式基础调用",
      "request": {
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "请输出三行：A、B、C"
          }
        ],
        "max_tokens": 512
      },
      "assertions": [
        "HTTP 200",
        "Content-Type 为 text/event-stream 或等价 SSE",
        "每个 data 事件均为合法 JSON（[DONE] 除外）",
        "正常收到 [DONE]",
        "存在 finish_reason=stop 或原厂等价结束语义",
        "正文可由 delta.content 按序拼接"
      ],
      "expected": {}
    },
    {
      "id": "K3-AUTH-001",
      "category": "认证与错误",
      "priority": "P0",
      "name": "无效认证",
      "request": {
        "headers": {
