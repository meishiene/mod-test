# 火山方舟 OpenAI 兼容接口（请显式 export，脚本不会自动读取 .env）
VOLC_API_KEY=replace-me
VOLC_BASE_URL=https://ark.cn-beijing.volces.com
VOLC_MODEL=replace-with-endpoint-or-model-id

# 可选
VOLC_CHAT_PATH=/chat/completions
VOLC_REQUEST_TIMEOUT_SECONDS=300
VOLC_CONNECT_TIMEOUT_SECONDS=30
VOLC_MAX_CONNECTIONS=1200
VOLC_VERIFY_SSL=true
VOLC_TRUST_ENV=false
# 仅当供应商接口不接受 stream_options 时设为 false；正式测试仍要求响应提供 usage。
VOLC_STREAM_INCLUDE_USAGE=true
# 协议：openai / openai_responses / openai_images / anthropic / gemini / volcengine
VOLC_PROTOCOL=volcengine

# GPT Image 单请求绝对总超时（秒），包括连接池等待、上传和完整响应读取。
GPT_IMAGE_REQUEST_TIMEOUT_SECONDS=300
# 4K / n=10 一次性验真单模型超时（秒）
GPT_IMAGE_4K_TIMEOUT_SECONDS=1800

# 跨模型公共契约探针（scripts/run_contracts.py）
# KVV 使用 VOLC_BASE_URL/VOLC_API_KEY/VOLC_MODEL
# DeepSeek 使用 DS_BASE_URL/DS_API_KEY/DS_MODEL
# GLM 使用 GLM_BASE_URL/GLM_API_KEY/GLM_MODEL
